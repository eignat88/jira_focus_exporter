        <mxCell id="XTTrb4EwFmW8RrTO6BQ7-8" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;ЛМ ЧЗ Кластер&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;text-align: center;&quot;&gt;В ЦО сейчас есть кластер из двух ПК с ЛМ ЧЗ (linux). Некоторые кассы &quot;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; background-color: transparent;&quot;&gt;ходят&quot; в этот кластер&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
