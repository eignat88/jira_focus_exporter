        #                    this.CreditCardCustRefId = creditCardCust.RecId;
        #                }
        #                else
        #                {
        #                    this.CreditCardCustRefId = 0;
        #                }
        #            }
        #            else
        #            {
        #                this.CreditCardCustRefId = 0;
        #            }
        #
