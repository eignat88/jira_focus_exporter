      SOURCE #_changeDeclaration
        #private void _changeDeclaration()
        #{
        #    /*
        #
        #    //SUP033_Issue_0929_VLAK, Добавление признака Свой клиент, vlak, 16.03.2020 -->
        #    //added
        #    \Data Dictionary\Tables\LFL_RequestTable\Fields\OurShop
        #    \Data Dictionary\Tables\LFL_RequestTable\Field Groups\General\OurShop
        #    //SUP033_Issue_0929_VLAK, Добавление признака Свой клиент, vlak, 16.03.2020 <--
        #
        #    //SUP031_FD_0825. Добавление признака «Консолидированная сборка»., yakr, 09.10.2019 -->
        #    //added
        #    \Data Dictionary\Tables\LFL_RequestTable\Fields\ConsolidationPicking
        #    \Data Dictionary\Tables\LFL_RequestTable\Field Groups\Freight\ConsolidationPicking
        #    //SUP031_FD_0825. Добавление признака «Консолидированная сборка»., yakr, 09.10.2019 <--
        #
