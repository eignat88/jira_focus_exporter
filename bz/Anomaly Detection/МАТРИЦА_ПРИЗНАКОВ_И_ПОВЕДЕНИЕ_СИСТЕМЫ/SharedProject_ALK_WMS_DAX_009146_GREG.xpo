    METHODS
      SOURCE #_changeDeclaration
        #// ALK_WMS, 02_FD_006, Перевод обмена заявками и откликами ERP-WMS на прямой обмен между БД (JIRA: DAX-878), 10.01.2020, kan
        #private void _changeDeclaration()
        #{
        #    /*
        #    //SUP043_Issue_1140_KIRD, Импорт консолидированных заявок, kirichen, 07.07.2021 -->
        #    add
        #        \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\LFL_ConsolidatePurchPriority
        #        \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Field Groups\AutoBrowse\LFL_ConsolidatePurchPriority
        #    //SUP043_Issue_1140_KIRD, Импорт консолидированных заявок, kirichen, 07.07.2021 <--
        #
        #    //ALK_WMS_DAX_1843_GREG, 01.03.2021 -->
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\DATA_ZAPL
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\DATA_OPL
        #    //ALK_WMS_DAX_1843_GREG, 01.03.2021 <--
        #
        #    //ALK_WMS_1244_GREG_FiscDocAddMarkCode, 10.01.2021 -->
        #    //added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\SelfCustomer
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\MPCommunicationMode
        #    //ALK_WMS_1244_GREG_FiscDocAddMarkCode, 10.01.2021 <--
        #
        #    //SUP033_Issue_0929_VLAK, Добавление признака Свой клиент, vlak, 16.03.2020 -->
        #    //added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\OurShop
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Field Groups\AutoBrowse\OurShop
        #    //SUP033_Issue_0929_VLAK, Добавление признака Свой клиент, vlak, 16.03.2020 <--
        #
        #    // + ALK_WMS, 1344, Выгрузка данных по транспорту, 10.07.2021, vologdin -->
        #    /added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\Driver
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\TruckName
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\TruckType
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\TruckNo
        #    // - ALK_WMS, 1344, Выгрузка данных по транспорту, 10.07.2021, vologdin <--
        #
        #    // + ALK_WMS, 1354, Добавление полей Окно доставки, 16.08.2021, vologdin -->
        #    added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\DelivTime
        #    // - ALK_WMS, 1354, Добавление полей Окно доставки, 16.08.2021, vologdin <--
        #
        #    // + ALK_WMS, 1365, WSS-1365 РЦ интеграция  отгрузка немаркированной продукции  по SSCC для Х5, 09.09.2021, vologdin -->
        #    added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\SSCC_DESDV
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Field Groups\AutoBrowse\SSCC_DESDV
        #    // - ALK_WMS, 1365, WSS-1365 РЦ интеграция  отгрузка немаркированной продукции  по SSCC для Х5, 09.09.2021, vologdin <--
        #
        #    // + ALK_DEVAX12, DAX_002428, Проформы с заданием на раскладку в прямом обмене, 07.07.2021, GREG -->
        #    added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\Priority
        #    // - ALK_DEVAX12, DAX_002428, Проформы с заданием на раскладку в прямом обмене, 07.07.2021, GREG <--
        #
        #    // + ALK_DEVAX12, DAX_003097, Распил с колёс - добавить в прямой обмен новое поле "Тип сортировки", 25.10.2021, GREG -->
        #    added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\SortType
        #    // - ALK_DEVAX12, DAX_003097, Распил с колёс - добавить в прямой обмен новое поле "Тип сортировки", 25.10.2021, GREG <--
        #
        #    // + ALK_WMS, DAX_003679, Номер водителя РЦ, 01.02.2022, vologdin -->
        #    added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\Driv_Phone
        #    // - ALK_WMS, DAX_003679, Номер водителя РЦ, 01.02.2022, vologdin <--
        #
        #    // + ALK_WMS, DAX_004075, Заявки/Отклики КМ, 07.06.2022, vologdin -->
        #    added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Indexes\NOMER_DOCIdx
        #    // - ALK_WMS, DAX_004075, Заявки/Отклики КМ, 07.06.2022, vologdin <--
        #
        #    // + ALK_WMS, DAX_004384, Признак Поставщики МП, 27.06.2022, vologdin -->
        #    added
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\SubType
        #    // - ALK_WMS, DAX_004384, Признак Поставщики МП, 27.06.2022, vologdin <--
        #
        #    // + ALK_WMS, DAX_004849, Импорт возврата из ПРТ, 19.10.2022, GREG -->
        #    Added:
        #        \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Fields\ReturnPRT
        #    // - ALK_WMS, DAX_004849, Импорт возврата из ПРТ, 19.10.2022, GREG <--
        #
        #    // + ALK_WMS, DAX_004705, Доработка формы Заявки и создание функциональности Приемка возвратов, 23.10.2022, adan -->
        #    Added:
        #    \Data Dictionary\Tables\LFL_RequestTable\Fields\ExpireDate
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Field Groups\AutoBrowse\ExpireDate
        #    \Data Dictionary\Tables\ALK_MsgReqDirectHeader\Field Groups\AutoBrowse\ReturnPRT
        #    // - ALK_WMS, DAX_004705, Доработка формы Заявки и создание функциональности Приемка возвратов, 23.10.2022, adan <--
