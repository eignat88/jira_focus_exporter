      SOURCE #calcRemainingTaxAmountMST_IN
        #/// <summary>
        #/// This method is used to get the original posted tax defered amount i.e the posted tax defered amount at the time of purchase of item
        #/// </summary>
        #/// <param name="_taxCode">
        #/// The tax code corresponding to which deferred amount is to be calculated
        #/// </param>
        #/// <param name="_exciseRecordType">
        #/// The excise record type to filter the correct register
        #/// </param>
        #/// <param name="_itemId">
        #/// The item for which the remaining tax amount is to be calculated
        #/// </param>
        #/// <param name="_inventBatchId">
        #/// The batch number used to find the original deferred amount
        #/// </param>
        #/// <returns>
        #/// The posted tax amount at the time of purchase
        #/// </returns>
        #// <GIN>
        #public TaxAmount calcRemainingTaxAmountMST_IN(TaxCode _taxCode, ExciseRecordType_IN _exciseRecordType, ItemId _itemId, InventBatchId _inventBatchId)
        #{
        #    CustInvoiceTrans    custInvoiceTrans;
        #    InventJournalTrans  inventJournalTrans;
        #    VendInvoiceTrans    vendInvoiceTrans;
        #    TaxTrans_IN         taxTrans;
        #    InventDim           inventDim;
        #    LedgerJournalTrans  ledgerJournalTrans;
        #
        #    TaxJourTransSourceTransLink_IN  taxJourTransSourceLink;
        #
        #    select sum(TaxAmount) from taxTrans
        #        where taxTrans.ExciseRecordType == _exciseRecordType
        #            && taxTrans.ItemId == _itemId
        #            && taxTrans.TaxCode == _taxCode
        #            && taxTrans.ExciseTariffCodes != 0
