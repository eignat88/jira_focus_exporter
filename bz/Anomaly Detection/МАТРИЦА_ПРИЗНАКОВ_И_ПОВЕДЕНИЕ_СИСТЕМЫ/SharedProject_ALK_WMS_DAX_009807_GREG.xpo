      SOURCE #getFiscalDocUsageType
        #/// <summary>
        #/// Тип использования фискальных документов при определении стоимости заявки
        #/// </summary>
        #/// <param name="_requestTable">
        #/// курсор заявки LFL_RequestTable
        #/// </param>
        #/// <returns>
        #/// Исходящий параметр (ENUM):LFL_FiscalDocUsageType
        #///•    Пусто – значение по умолчанию. Метод вызван не для расходной заявки.
        #///•    ИМ – заявка интернет магазина. Цены должны определяться из заявки. Фискальные документы по таким заявкам в WMS не передаются.
        #///•    ИМ Самовывоз (не пересчитан) – заявка интернет магазина (с самовывозом оплаченного товара из магазина собственной сети) для склада которой настроена печать фискальных документов. «Не пересчитан» означает, что перед печатью в фискальных документах необходимо заполнить фактические поля по собранному количеству.
        #///•    ИМ Самовывоз (пересчитан) – аналогично предыдущему пункту, но фискальные документы уже подготовлены к печати.
        #///•    Кросс-докинг (не пересчитан) – заявка кросс докинга. Фискальные документы по такой заявке должны передаваться в WMS. Печатные документы формируются на количество в исходной заявке. «Не пересчитан» означает, что перед печатью в фискальном документе необходимо заполнить фактические поля из плановых.
        #///•    Кросс-докинг (пересчитан) – аналогично предыдущему пункту, но фискальный документ уже подготовлен к печати.
        #///•    Не фискальный – заявка не является фискальной, т.к. отгружается со склада, для которого не требуется печать фискальных документов (например, отгрузка со склада брака, списаний и т.п.) или в заявке установлен признак «Не требуется фискализация»
        #///•    Фискализировано (не пересчитан) - обычная заявка (не кросс-докинг и не ИМ), для склада которой настроена печать фискальных документов. «Не пересчитан» означает, что перед печатью в фискальном документе необходимо заполнить фактические поля по собранному количеству.
        #///•    Фискализировано (пересчитан) – аналогично предыдущему пункту, но фискальный документ уже подготовлен к печати.
        #///•    Не фискализировано - вид заявки предусматривает печать фискальных документов, но документы или не получены, или получены не полностью из ERP.
        #/// </returns>
        #/// <remarks>
        #/// Метод используется в пересчете фискальных документови формировании документов для базы печати
        #/// </remarks>
        #//SUP027, FD_0027_12, Доработка печати экспедиторской расписки, 06.07.2018, ext-dedm
        #static server LFL_FiscalDocUsageType getFiscalDocUsageType(LFL_RequestTable _requestTable)
        #{
        #    LFL_FiscalDocUsageType      ret = LFL_FiscalDocUsageType::None;
        #    SalesTable                  salesTable;
        #    LFL_RequestTableES          requestTableES;
        #    InventLocation              inventLocation;
        #    ;
        #    if (_requestTable.RequestType == LFL_RequestType::Issue)
        #    {
        #        if (_requestTable.FiscalizationNotRequired)
        #            return LFL_FiscalDocUsageType::NotFiscal;
        #
        #        salesTable = _requestTable.salesTable();
        #        if (!salesTable.RecId)
        #            return ret;
        #
        #        if (salesTable.lfl_isInternetShop())
        #        {
        #            requestTableES = _requestTable.requestTableES();
        #            if (requestTableES.RecId && requestTableES.DeliveryType == LFL_DeliveryType::Shop)
        #            {
        #                if (!_requestTable.Fiscalized)
        #                    return LFL_FiscalDocUsageType::WasNotFiscalized;
        #                else  if (!_requestTable.DocsReady)
        #                    return LFL_FiscalDocUsageType::IMSelfDeliveryNotCalculated;
        #                else
        #                    return LFL_FiscalDocUsageType::IMSelfDeliveryCalculated;
        #            }
        #            return LFL_FiscalDocUsageType::IM;
        #        }
        #
        #        inventLocation = InventLocation::find(_requestTable.SKLAD_KOD);
        #        if (!inventLocation.LFL_DocPrintDataExport)
        #            return LFL_FiscalDocUsageType::NotFiscal;
        #
        #        if (!_requestTable.Fiscalized)
        #            return LFL_FiscalDocUsageType::WasNotFiscalized;
        #
        #        if (salesTable.SalesPoolId == SalesParameters::find().WMS_CDSalesPoolId)
        #        {
        #            if (!_requestTable.DocsReady)
        #                return LFL_FiscalDocUsageType::CrossDockingNotCalculated;
        #            else
        #                return LFL_FiscalDocUsageType::CrossDockingCalculated;
        #        }
        #
        #        if (!_requestTable.DocsReady)
